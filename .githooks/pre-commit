#!/usr/bin/env fish

function die
    echo "pre-commit: "(string join ' ' $argv) >&2
    exit 1
end

function test_report_passed --argument-names test_class
    set report_file "target/surefire-reports/TEST-com.albin.neetcode.$test_class.xml"
    test -f "$report_file"; or die \
        "Maven did not produce a Surefire report for $test_class."

    set report_summary (string match -r -m 1 '<testsuite[^>]*>' <"$report_file")
    set report_failures (string match -r --groups-only ' failures="([0-9]+)"' -- "$report_summary")
    set report_errors (string match -r --groups-only ' errors="([0-9]+)"' -- "$report_summary")
    test -n "$report_failures"; and test -n "$report_errors"; or die \
        "Could not read the Surefire result for $test_class."

    test "$report_failures" -eq 0; and test "$report_errors" -eq 0
end

function update_progress_svg --argument-names readme_contents
    set problem_rows (string split \n -- "$readme_contents" |
        string match -r '^\| .+ \| (?:✓|○) \|$')
    set solved_rows (string match -r '^\| .+ \| ✓ \|$' -- $problem_rows)
    set total_count (count $problem_rows)
    set solved_count (count $solved_rows)
    test "$total_count" -gt 0; or die 'Could not find problem rows in README.md.'

    set track_width 624
    set filled_width (math --scale=0 "$solved_count * $track_width / $total_count + 0.5")
    set percentage (math --scale=0 "$solved_count * 100 / $total_count + 0.5")

    printf '%s\n' \
        '<svg xmlns="http://www.w3.org/2000/svg" width="640" height="64" viewBox="0 0 640 64" role="img" aria-labelledby="title description">' \
        "  <title id=\"title\">NeetCode 150 progress: $solved_count of $total_count solved</title>" \
        "  <desc id=\"description\">$percentage percent complete</desc>" \
        '  <defs>' \
        '    <linearGradient id="progress-gradient" x1="0" x2="1">' \
        '      <stop offset="0%" stop-color="#238636"/>' \
        '      <stop offset="100%" stop-color="#2ea043"/>' \
        '    </linearGradient>' \
        '  </defs>' \
        '  <rect x="8" y="12" width="624" height="40" rx="20" fill="#30363d"/>' \
        "  <rect x=\"8\" y=\"12\" width=\"$filled_width\" height=\"40\" rx=\"20\" fill=\"url(#progress-gradient)\"/>" \
        "  <text x=\"320\" y=\"33\" fill=\"#ffffff\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif\" font-size=\"15\" font-weight=\"600\" text-anchor=\"middle\" dominant-baseline=\"middle\">$solved_count / $total_count solved · $percentage%</text>" \
        '</svg>' >progress.svg
end

set repository_root (git rev-parse --show-toplevel 2>/dev/null)
test -n "$repository_root"; or die 'Not inside a Git repository.'
cd "$repository_root"; or die 'Could not enter the repository root.'

# Collect and validate changed problems.
set changed_problems (git diff --cached --name-only --diff-filter=ACMR -- \
        'src/main/java/com/albin/neetcode/*.java' \
        'src/test/java/com/albin/neetcode/*Test.java' |
    path basename -E | string replace -r 'Test$' '' | sort -u)
set -q changed_problems[1]; or exit 0

set eligible_problems
set test_classes
set readme_statuses
for problem_class in $changed_problems
    set solution_file "src/main/java/com/albin/neetcode/$problem_class.java"
    set test_class {$problem_class}Test
    set test_file "src/test/java/com/albin/neetcode/"{$test_class}".java"

    # Incomplete solution/test pairs are intentionally skipped.
    if not test -f "$solution_file"; or not test -f "$test_file"
        echo "pre-commit: Skipping $problem_class; both classes are required."
        continue
    end

    git diff --quiet -- "$solution_file" "$test_file"; or die \
        "$problem_class has unstaged changes; stage or stash them before committing."

    set readme_row (string match -m 1 "*($solution_file)*" < README.md)
    test -n "$readme_row"; or die "$problem_class is missing from the README table."
    set readme_status (string match -r --groups-only '\| (✓|○) \|' -- "$readme_row")
    test -n "$readme_status"; or die "$problem_class has an invalid README status."

    set -a eligible_problems "$problem_class"
    set -a test_classes "$test_class"
    set -a readme_statuses "$readme_status"
end

set -q eligible_problems[1]; or exit 0

# Run all changed tests in one Maven invocation.
# Remove only the reports that this run must recreate. Otherwise a Maven failure
# before test execution could make a stale report look like a current result.
for test_class in $test_classes
    set report_file "target/surefire-reports/TEST-com.albin.neetcode.$test_class.xml"
    command rm -f "$report_file"
end

set test_filter (string join , $test_classes)
echo "pre-commit: Running "(count $test_classes)" changed test classes..."
set maven_failed false
mvn -q -Dtest="$test_filter" test; or set maven_failed true

# Process each test class's result.
set newly_solved_problems
set test_failures_found false
for problem_index in (seq (count $eligible_problems))
    set problem_class $eligible_problems[$problem_index]
    set solution_file "src/main/java/com/albin/neetcode/$problem_class.java"
    set test_class $test_classes[$problem_index]
    set readme_status $readme_statuses[$problem_index]

    if test_report_passed "$test_class"
        # A test-only commit may validate a problem, but it must not claim that
        # the corresponding solution is included in the commit being made.
        if test "$readme_status" = ○; and not git diff --cached --quiet -- "$solution_file"
            set -a newly_solved_problems "$problem_class"
        end
    else
        set test_failures_found true
        if test "$readme_status" = ✓
            die "$problem_class is marked Solved, but its tests failed."
        end

        # Red tests are allowed while a problem remains in progress.
        echo "pre-commit: $problem_class remains In progress because its tests failed."
    end
end

# A nonzero Maven exit is expected when an in-progress test is red. If every
# report passed, the failure came from somewhere else in the Maven lifecycle.
if test "$maven_failed" = true; and test "$test_failures_found" = false
    die 'Maven failed even though all changed test reports passed.'
end

# Update and stage README statuses for newly solved problems.
set -q newly_solved_problems[1]; or exit 0
git diff --quiet -- README.md progress.svg; or die \
    'README.md or progress.svg has unstaged changes; stage or stash them before committing.'

set readme_contents (string collect < README.md)
for problem_class in $newly_solved_problems
    set solution_file "src/main/java/com/albin/neetcode/$problem_class.java"
    set readme_row (string split \n -- "$readme_contents" | string match -m 1 "*($solution_file)*")
    set solved_row (string replace '| ○ |' '| ✓ |' -- "$readme_row")
    set readme_contents (string replace "$readme_row" "$solved_row" -- "$readme_contents" | string collect)
    echo "pre-commit: Marked $problem_class as Solved in README.md."
end

update_progress_svg "$readme_contents"; or die 'Could not update progress.svg.'

printf '%s\n' "$readme_contents" >README.md; or die 'Could not write README.md.'
git add README.md progress.svg; or die 'Could not stage README.md and progress.svg.'
echo 'pre-commit: Staged README.md status and progress updates.'
